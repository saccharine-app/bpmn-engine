<?php

namespace App\Filament\Resources\Bpmn;

use Filament\Forms;
use Filament\Schemas;
use Filament\Tables;
use Filament\Resources\Resource;
use Filament\Actions\Action;
use Filament\Actions\EditAction;
use Filament\Forms\Components\TextInput;
use Illuminate\Support\Str;
use Saccharine\BpmnEngine\Models\WorkflowDefinition;
use App\Filament\Resources\Bpmn\WorkflowDefinitionResource\Pages;

class WorkflowDefinitionResource extends Resource
{
    protected static ?string $model = WorkflowDefinition::class;
    protected static \BackedEnum|string|null $navigationIcon = 'heroicon-o-rectangle-group';
    protected static \UnitEnum|string|null $navigationGroup = 'Process Orchestration';

    public static function form(Schemas\Schema $schema): Schemas\Schema
    {
        return $schema
            ->components([
                TextInput::make('name')
                    ->required()
                    ->maxLength(255)
                    ->live(onBlur: true) // Triggers a re-render when the user clicks out
                    ->afterStateUpdated(function (string $operation, $state, Forms\Set $set) {
                        // Auto-generate the unique key based on the name during creation
                        if ($operation === 'create') {
                            $set('key', Str::slug($state));
                        }
                    }),

                TextInput::make('key')
                    ->required()
                    ->unique(ignoreRecord: true)
                    ->maxLength(255)
                    ->helperText('A unique, machine-readable identifier (e.g., onboarding-process).'),
            ]);
    }

    public static function table(Tables\Table $table): Tables\Table
    {
        return $table
            ->columns([
                Tables\Columns\TextColumn::make('name')->searchable(),
                Tables\Columns\TextColumn::make('key')->searchable(),
                Tables\Columns\TextColumn::make('versions_count')
                    ->counts('versions')
                    ->label('Versions'),
                Tables\Columns\TextColumn::make('updated_at')
                    ->dateTime()
                    ->sortable(),
            ])
            ->actions([
                EditAction::make(),
                
                // The bridge to your standalone BPMN Modeler
                Action::make('design')
                    ->label('Open Designer')
                    ->icon('heroicon-o-paint-brush')
                    ->color('info')
                    ->url(fn (WorkflowDefinition $record): string => route('bpmn.design', $record->id))
                    ->openUrlInNewTab(),
            ]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListWorkflowDefinitions::route('/'),
        ];
    }
}